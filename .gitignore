# Ignore persistent container data & databases
**/data/
**/etc-pihole/
**/etc-dnsmasq.d/
**/grafana-data/
**/prometheus-data/
**/letsencrypt/
**/open-webui/
**/ollama/

# Ignore environment files & secrets
**/.env
**/*.key
**/*.pem

# Ignore OS & editor files
.DS_Store
*.log
Thumbs.db

# Homepage runtime logs
homepage/config/logs/

# Configuración local de backups
backups/backup.env
